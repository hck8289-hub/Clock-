<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Retro Flip Clock | 復古翻頁鐘</title>
  <style>
    /* ----------------------------------------------------
       1. 全局變數與基礎設定
    ---------------------------------------------------- */
    :root {
      --bg-color: #0f1115;
      --card-bg: #1e222b;
      --card-gradient-top: #252a35;
      --card-gradient-bottom: #191c24;
      --text-color: #f0f3f8;
      --accent-color: #4f46e5;
      --accent-hover: #6366f1;
      --border-color: #2e3545;
      --shadow-color: rgba(0, 0, 0, 0.6);
      --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: var(--font-family);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }

    .container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
      max-width: 1000px;
      width: 100%;
    }

    /* ----------------------------------------------------
       2. Header & 控制列 (日期/格式切換)
    ---------------------------------------------------- */
    .header-panel {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      max-width: 780px;
      padding: 0 10px;
    }

    .date-display {
      font-size: 1.25rem;
      font-weight: 500;
      letter-spacing: 1px;
      color: #9ca3af;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .day-badge {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      color: #e5e7eb;
      padding: 4px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .format-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--card-bg);
      padding: 6px 12px;
      border-radius: 20px;
      border: 1px solid var(--border-color);
    }

    .format-toggle span {
      font-size: 0.85rem;
      color: #9ca3af;
      font-weight: 600;
    }

    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 22px;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #374151;
      transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 22px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--accent-color);
    }

    input:checked + .slider:before {
      transform: translateX(22px);
    }

    /* ----------------------------------------------------
       3. 翻頁鐘主體 UI Components
    ---------------------------------------------------- */
    .clock-grid {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      position: relative;
    }

    .group-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .flip-group {
      display: flex;
      gap: 8px;
    }

    .group-label {
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #6b7280;
    }

    .separator {
      font-size: 3.5rem;
      font-weight: 700;
      color: #4b5563;
      margin-top: -25px;
      user-select: none;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* AM/PM 標示 */
    .ampm-indicator {
      position: absolute;
      right: -55px;
      bottom: 40px;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent-color);
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 6px 10px;
      border-radius: 8px;
      letter-spacing: 1px;
      display: none; /* 24H 模式下隱藏 */
    }

    /* ----------------------------------------------------
       4. 3D 翻頁卡片核心 CSS (Flip Card Core)
    ---------------------------------------------------- */
    .flip-card {
      position: relative;
      width: 100px;
      height: 140px;
      font-size: 5.5rem;
      font-weight: 800;
      line-height: 140px;
      border-radius: 12px;
      perspective: 400px;
      box-shadow: 0 10px 25px var(--shadow-color);
      user-select: none;
    }

    /* 上半部與下半部通用樣式 */
    .card-top, .card-bottom {
      position: absolute;
      left: 0;
      right: 0;
      overflow: hidden;
      background: linear-gradient(180deg, var(--card-gradient-top) 0%, var(--card-gradient-bottom) 100%);
      text-align: center;
      color: var(--text-color);
      border-left: 1px solid rgba(255, 255, 255, 0.05);
      border-right: 1px solid rgba(255, 255, 255, 0.05);
    }

    .card-top {
      top: 0;
      height: 50%;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(0, 0, 0, 0.7);
    }

    .card-top span {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    .card-bottom {
      bottom: 0;
      height: 50%;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.5);
    }

    .card-bottom span {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    /* 卡片中央分隔裂縫效果 */
    .flip-card::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 2px;
      background-color: rgba(10, 12, 16, 0.8);
      transform: translateY(-50%);
      z-index: 5;
      box-shadow: 0 1px 1px rgba(255, 255, 255, 0.05);
    }

    /* 翻頁動態疊層 */
    .flip-card .flip-leaf-top,
    .flip-card .flip-leaf-bottom {
      position: absolute;
      left: 0;
      right: 0;
      height: 50%;
      overflow: hidden;
      background: linear-gradient(180deg, var(--card-gradient-top) 0%, var(--card-gradient-bottom) 100%);
      text-align: center;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    .flip-card .flip-leaf-top {
      top: 0;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
      transform-origin: bottom;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(0, 0, 0, 0.7);
      z-index: 3;
    }

    .flip-card .flip-leaf-top span {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    .flip-card .flip-leaf-bottom {
      bottom: 0;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
      transform-origin: top;
      border-bottom: 1px solid rgba(0, 0, 0, 0.5);
      z-index: 2;
    }

    .flip-card .flip-leaf-bottom span {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    /* 翻頁動畫 Keyframes */
    .flip-card.flipping .flip-leaf-top {
      animation: flip-top 0.3s ease-in forwards;
    }

    .flip-card.flipping .flip-leaf-bottom {
      animation: flip-bottom 0.3s 0.3s ease-out forwards;
    }

    @keyframes flip-top {
      0% { transform: rotateX(0deg); }
      100% { transform: rotateX(-90deg); }
    }

    @keyframes flip-bottom {
      0% { transform: rotateX(90deg); }
      100% { transform: rotateX(0deg); }
    }

    /* ----------------------------------------------------
       5. 響應式微調 (RWD)
    ---------------------------------------------------- */
    @media (max-width: 768px) {
      .header-panel {
        flex-direction: column-reverse;
        gap: 15px;
      }
      .clock-grid {
        gap: 10px;
      }
      .flip-card {
        width: 54px;
        height: 80px;
        font-size: 3.2rem;
        line-height: 80px;
        border-radius: 8px;
      }
      .card-top, .card-leaf-top { border-top-left-radius: 8px; border-top-right-radius: 8px; }
      .card-bottom, .card-leaf-bottom { border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
      .separator {
        font-size: 2rem;
        margin-top: -15px;
      }
      .ampm-indicator {
        position: relative;
        right: auto;
        bottom: auto;
        align-self: center;
        margin-top: 10px;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- 頂部資訊與控制欄 -->
    <div class="header-panel">
      <div class="date-display">
        <span id="date-text">---- 年 -- 月 -- 日</span>
        <span id="day-text" class="day-badge">---</span>
      </div>

      <div class="format-toggle">
        <span>12H</span>
        <label class="switch">
          <input type="checkbox" id="format-switch" checked>
          <span class="slider"></span>
        </label>
        <span>24H</span>
      </div>
    </div>

    <!-- 翻頁鐘主要區域 -->
    <div class="clock-grid">
      <!-- 小時 -->
      <div class="group-container">
        <div class="flip-group">
          <div class="flip-card" id="h1"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
          <div class="flip-card" id="h2"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
        </div>
        <span class="group-label">Hours</span>
      </div>

      <div class="separator">:</div>

      <!-- 分鐘 -->
      <div class="group-container">
        <div class="flip-group">
          <div class="flip-card" id="m1"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
          <div class="flip-card" id="m2"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
        </div>
        <span class="group-label">Minutes</span>
      </div>

      <div class="separator">:</div>

      <!-- 秒鐘 -->
      <div class="group-container">
        <div class="flip-group">
          <div class="flip-card" id="s1"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
          <div class="flip-card" id="s2"><div class="card-top"><span>0</span></div><div class="card-bottom"><span>0</span></div></div>
        </div>
        <span class="group-label">Seconds</span>
      </div>

      <!-- AM/PM 標示 (僅 12H 模式顯示) -->
      <div id="ampm" class="ampm-indicator">AM</div>
    </div>
  </div>

  <script>
    /**
     * 翻頁卡片類別 (FlipCard Class)
     * 封裝單一數字卡片的 DOM 結構控制與 3D 翻頁動畫邏輯
     */
    class FlipCard {
      constructor(element) {
        this.element = element;
        this.topVal = this.element.querySelector('.card-top span');
        this.bottomVal = this.element.querySelector('.card-bottom span');
        this.currentValue = '0';
      }

      /**
       * 設置數值並觸發動畫
       * @param {string|number} newValue - 新數字
       */
      setVal(newValue) {
        newValue = String(newValue);
        if (this.currentValue === newValue) return;

        // 移除先前的動畫殘留
        this.element.classList.remove('flipping');
        const oldLeaves = this.element.querySelectorAll('.flip-leaf-top, .flip-leaf-bottom');
        oldLeaves.forEach(node => node.remove());

        // 建立動畫頁片
        const leafTop = document.createElement('div');
        leafTop.className = 'flip-leaf-top';
        leafTop.innerHTML = `<span>${this.currentValue}</span>`;

        const leafBottom = document.createElement('div');
        leafBottom.className = 'flip-leaf-bottom';
        leafBottom.innerHTML = `<span>${newValue}</span>`;

        // 預先更新下半部底層背景為新數字
        this.bottomVal.textContent = newValue;

        // 插入動畫節點
        this.element.appendChild(leafTop);
        this.element.appendChild(leafBottom);

        // 強制 DOM 重繪以確保 CSS 動畫流暢觸發
        void this.element.offsetWidth;
        this.element.classList.add('flipping');

        // 動畫結束後更新上半部背景並清理 DOM
        setTimeout(() => {
          this.topVal.textContent = newValue;
          leafTop.remove();
          leafBottom.remove();
          this.element.classList.remove('flipping');
        }, 600);

        this.currentValue = newValue;
      }

      /**
       * 強制刷新（無視動畫，用於切換 12/24H 模式）
       */
      setValueDirectly(newValue) {
        newValue = String(newValue);
        this.currentValue = newValue;
        this.topVal.textContent = newValue;
        this.bottomVal.textContent = newValue;
      }
    }

    /* ----------------------------------------------------
       時鐘主體邏輯控制器
    ---------------------------------------------------- */
    document.addEventListener('DOMContentLoaded', () => {
      // 初始化 6 個翻頁單元
      const cards = {
        h1: new FlipCard(document.getElementById('h1')),
        h2: new FlipCard(document.getElementById('h2')),
        m1: new FlipCard(document.getElementById('m1')),
        m2: new FlipCard(document.getElementById('m2')),
        s1: new FlipCard(document.getElementById('s1')),
        s2: new FlipCard(document.getElementById('s2'))
      };

      const dateText = document.getElementById('date-text');
      const dayText = document.getElementById('day-text');
      const ampmText = document.getElementById('ampm');
      const formatSwitch = document.getElementById('format-switch');

      let is24HourMode = formatSwitch.checked;
      let lastDateString = '';

      const daysOfWeek = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];

      // 切換開關事件
      formatSwitch.addEventListener('change', (e) => {
        is24HourMode = e.target.checked;
        updateClock(true); // 強制重新整理
      });

      /**
       * 時鐘核心更新函式
       * @param {boolean} forceReset - 是否無視動畫強制刷新 DOM
       */
      function updateClock(forceReset = false) {
        const now = new Date();

        // 1. 更新日期 (每日更新一次即可)
        const dateStr = `${now.getFullYear()} 年 ${now.getMonth() + 1} 月 ${now.getDate()} 日`;
        if (dateStr !== lastDateString) {
          dateText.textContent = dateStr;
          dayText.textContent = daysOfWeek[now.getDay()];
          lastDateString = dateStr;
        }

        // 2. 解析時間數值
        let hours = now.getHours();
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        if (!is24HourMode) {
          ampmText.style.display = 'block';
          ampmText.textContent = hours >= 12 ? 'PM' : 'AM';
          hours = hours % 12;
          hours = hours ? hours : 12; // 0 時轉為 12
        } else {
          ampmText.style.display = 'none';
        }

        const hoursStr = String(hours).padStart(2, '0');

        // 3. 套用至翻頁卡片
        const targetValues = {
          h1: hoursStr[0], h2: hoursStr[1],
          m1: minutes[0],  m2: minutes[1],
          s1: seconds[0],  s2: seconds[1]
        };

        Object.keys(cards).forEach(key => {
          if (forceReset) {
            cards[key].setValueDirectly(targetValues[key]);
          } else {
            cards[key].setVal(targetValues[key]);
          }
        });
      }

      // 初始化顯示並建立高頻校準 Timer
      updateClock(true);
      setInterval(() => updateClock(false), 1000);
    });
  </script>
</body>
</html>
