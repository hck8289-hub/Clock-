const questionTextEl = document.getElementById('question-text');
const currentNumEl = document.getElementById('current-num');
const totalCountEl = document.getElementById('total-count');
const scoreEl = document.getElementById('score');
const btnTrue = document.getElementById('btn-true');
const btnFalse = document.getElementById('btn-false');
const explainBlock = document.getElementById('explain-block');
const explainContent = document.getElementById('explain-content');
const btnNext = document.getElementById('btn-next');
const finalBlock = document.getElementById('final-block');
const finalScoreEl = document.getElementById('final-score');
const finalTotalEl = document.getElementById('final-total');
const btnRestart = document.getElementById('btn-restart');
const selectButtons = document.getElementById('select-buttons');

// 打乱数组（随机不重复抽取全部题目）
function shuffleArray(arr) {
    const copy = [...arr];
    for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
}

// 加载当前题目
function loadQuestion() {
    explainBlock.style.display = 'none';
    selectButtons.style.display = 'flex';
    btnTrue.disabled = false;
    btnFalse.disabled = false;
    finalBlock.style.display = 'none';

    const item = shuffledList[currentQuestionIndex];
    questionTextEl.innerText = item.q;
    currentNumEl.innerText = currentQuestionIndex + 1;
    totalCountEl.innerText = shuffledList.length;
    scoreEl.innerText = score;
}

// 作答处理
function handleAnswer(userSelect) {
    btnTrue.disabled = true;
    btnFalse.disabled = true;
    const item = shuffledList[currentQuestionIndex];
    const isCorrect = userSelect === item.ans;
    if (isCorrect) score++;
    scoreEl.innerText = score;

    // 展示解析
    explainBlock.style.display = 'block';
    let resultText = isCorrect ? "✅ 回答正确！" : "❌ 回答错误";
    explainContent.innerHTML = `${resultText}<br><br>${item.desc}`;
}

// 下一题（修复提前结束bug：判断索引等于总长度才结束）
function nextQuestion() {
    currentQuestionIndex++;
    if (currentQuestionIndex >= shuffledList.length) {
        // 全部题目完成，结束游戏
        selectButtons.style.display = 'none';
        explainBlock.style.display = 'none';
        finalBlock.style.display = 'block';
        finalScoreEl.innerText = score;
        finalTotalEl.innerText = shuffledList.length;
        return;
    }
    loadQuestion();
}

// 重新开始游戏
function restartGame() {
    currentQuestionIndex = 0;
    score = 0;
    shuffledList = shuffleArray(questionList);
    loadQuestion();
}

// 绑定按钮事件
btnTrue.addEventListener('click', () => handleAnswer(true));
btnFalse.addEventListener('click', () => handleAnswer(false));
btnNext.addEventListener('click', nextQuestion);
btnRestart.addEventListener('click', restartGame);

// 页面初始化启动游戏
restartGame();
</script>
</body>
</html>
